          "type": "string"
        },
        "expected_artifact_digest": {
          "description": "可选：期望的工件 digest",
          "type": "string"
        },
        "expected_plan_digest": {
          "description": "签发时的计划 digest；计划变化即 scope_mismatch",
          "minLength": 1,
          "type": "string"
